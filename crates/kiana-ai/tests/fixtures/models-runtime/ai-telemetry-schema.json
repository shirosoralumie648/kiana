{
  "version": 1,
  "spans": {
    "kiana.ai.request": {
      "description": "One logical model request, including authentication and provider setup.",
      "parents": {
        "kind": "any"
      },
      "startAttributes": {
        "provider": {
          "type": "string",
          "description": "Provider identifier.",
          "required": true
        },
        "api": {
          "type": "string",
          "description": "API identifier.",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Requested model identifier.",
          "required": true
        },
        "reasoning": {
          "type": "string",
          "description": "Scalar requested reasoning level.",
          "required": false
        }
      },
      "endAttributes": {
        "stop": {
          "type": "string",
          "description": "Normalized stop reason.",
          "values": [
            "pending",
            "stop",
            "length",
            "toolUse",
            "error",
            "aborted",
            "deferred"
          ]
        },
        "usage.input": {
          "type": "number",
          "description": "Uncached input tokens."
        },
        "usage.output": {
          "type": "number",
          "description": "Output tokens."
        },
        "usage.cache_read": {
          "type": "number",
          "description": "Cache-read tokens."
        },
        "usage.cache_write": {
          "type": "number",
          "description": "Cache-write tokens."
        },
        "cost.total": {
          "type": "number",
          "description": "Total request cost in USD."
        },
        "response.id": {
          "type": "string",
          "description": "Provider response identifier.",
          "cardinality": "high"
        }
      },
      "events": {
        "kiana.ai.first_chunk": {
          "description": "First normalized stream event delivered.",
          "attributes": {}
        },
        "kiana.ai.block": {
          "description": "A completed content block; content is never recorded.",
          "attributes": {
            "type": {
              "type": "string",
              "description": "Block kind.",
              "values": [
                "text",
                "thinking",
                "tool_call"
              ],
              "required": true
            },
            "index": {
              "type": "number",
              "description": "Content block index.",
              "required": true
            },
            "chars": {
              "type": "number",
              "description": "UTF-16 character count.",
              "required": true
            },
            "tool": {
              "type": "string",
              "description": "Tool name, for tool-call blocks only.",
              "required": false
            }
          }
        }
      },
      "status": {
        "default": "ok",
        "errorWhen": "Stop reason is error: provider_error with at most 500 error-message characters. Aborted stays ok."
      }
    },
    "kiana.ai.poll": {
      "description": "One deferred-response poll, not the deferred request's lifetime.",
      "parents": {
        "kind": "any"
      },
      "startAttributes": {
        "provider": {
          "type": "string",
          "description": "Provider identifier.",
          "required": true
        },
        "api": {
          "type": "string",
          "description": "API identifier.",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Requested model identifier.",
          "required": true
        },
        "reasoning": {
          "type": "string",
          "description": "Scalar requested reasoning level.",
          "required": false
        }
      },
      "endAttributes": {
        "stop": {
          "type": "string",
          "description": "Normalized stop reason.",
          "values": [
            "pending",
            "stop",
            "length",
            "toolUse",
            "error",
            "aborted",
            "deferred"
          ]
        },
        "usage.input": {
          "type": "number",
          "description": "Uncached input tokens."
        },
        "usage.output": {
          "type": "number",
          "description": "Output tokens."
        },
        "usage.cache_read": {
          "type": "number",
          "description": "Cache-read tokens."
        },
        "usage.cache_write": {
          "type": "number",
          "description": "Cache-write tokens."
        },
        "cost.total": {
          "type": "number",
          "description": "Total request cost in USD."
        },
        "response.id": {
          "type": "string",
          "description": "Provider response identifier.",
          "cardinality": "high"
        }
      },
      "events": {
        "kiana.ai.first_chunk": {
          "description": "First normalized stream event delivered.",
          "attributes": {}
        },
        "kiana.ai.block": {
          "description": "A completed content block; content is never recorded.",
          "attributes": {
            "type": {
              "type": "string",
              "description": "Block kind.",
              "values": [
                "text",
                "thinking",
                "tool_call"
              ],
              "required": true
            },
            "index": {
              "type": "number",
              "description": "Content block index.",
              "required": true
            },
            "chars": {
              "type": "number",
              "description": "UTF-16 character count.",
              "required": true
            },
            "tool": {
              "type": "string",
              "description": "Tool name, for tool-call blocks only.",
              "required": false
            }
          }
        }
      },
      "status": {
        "default": "ok",
        "errorWhen": "Stop reason is error: provider_error with at most 500 error-message characters. Aborted stays ok."
      }
    }
  },
  "metrics": {
    "kiana.ai.request.duration": {
      "kind": "histogram",
      "description": "Logical request or poll duration.",
      "unit": "ms",
      "attributes": {
        "provider": {
          "type": "string",
          "description": "Provider identifier.",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Requested model identifier.",
          "required": true
        },
        "stop": {
          "type": "string",
          "description": "Normalized stop reason.",
          "values": [
            "pending",
            "stop",
            "length",
            "toolUse",
            "error",
            "aborted",
            "deferred"
          ],
          "required": true
        }
      }
    },
    "kiana.ai.first_chunk.duration": {
      "kind": "histogram",
      "description": "Time to the first normalized stream event.",
      "unit": "ms",
      "attributes": {
        "provider": {
          "type": "string",
          "description": "Provider identifier.",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Requested model identifier.",
          "required": true
        }
      }
    },
    "kiana.ai.tokens": {
      "kind": "counter",
      "description": "Reported model token usage; pending and deferred polls are excluded.",
      "unit": "token",
      "attributes": {
        "provider": {
          "type": "string",
          "description": "Provider identifier.",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Requested model identifier.",
          "required": true
        },
        "kind": {
          "type": "string",
          "description": "Token usage category.",
          "values": [
            "input",
            "output",
            "cache_read",
            "cache_write"
          ],
          "required": true
        }
      }
    },
    "kiana.ai.cost": {
      "kind": "counter",
      "description": "Reported model cost; pending and deferred polls are excluded.",
      "unit": "USD",
      "attributes": {
        "provider": {
          "type": "string",
          "description": "Provider identifier.",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Requested model identifier.",
          "required": true
        }
      }
    }
  }
}
