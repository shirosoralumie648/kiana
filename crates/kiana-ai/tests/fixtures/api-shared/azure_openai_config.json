    "baseUrl": "https://model.example.com"
   },
   "options": {
    "azureApiVersion": "2024-10-21"
   },
   "expected": {
    "ok": {
     "baseUrl": "https://model.example.com",
     "apiVersion": "2024-10-21"
    }
   }
  },
  {
