 "optionCases": [
  {
   "name": "resource",
   "model": {
    "id": "gpt-4o",
    "baseUrl": ""
   },
   "options": {
    "azureResourceName": "my-res"
   },
   "expected": {
    "ok": "https://my-res.openai.azure.com/openai/v1"
   }
  },
  {
   "name": "optionsBase",
   "model": {
    "id": "gpt-4o",
    "baseUrl": "https://model.example.com"
   },
   "options": {
    "azureBaseUrl": " https://explicit.example.com/v1/ "
   },
   "expected": {
    "ok": "https://explicit.example.com/v1"
   }
  },
  {
   "name": "optionsBaseBeatsEnv",
   "model": {
    "id": "gpt-4o",
    "baseUrl": ""
   },
   "options": {
    "azureBaseUrl": "https://explicit.example.com",
    "env": {
     "AZURE_OPENAI_BASE_URL": "https://env.example.com",
     "AZURE_OPENAI_RESOURCE_NAME": "envres"
    }
   },
   "expected": {
    "ok": "https://explicit.example.com"
   }
  },
  {
   "name": "envBase",
   "model": {
    "id": "gpt-4o",
    "baseUrl": ""
   },
   "options": {
    "env": {
     "AZURE_OPENAI_BASE_URL": "  https://env.example.com/v1/ "
    }
   },
   "expected": {
    "ok": "https://env.example.com/v1"
   }
  },
  {
   "name": "envResource",
   "model": {
    "id": "gpt-4o",
    "baseUrl": ""
   },
   "options": {
    "env": {
     "AZURE_OPENAI_RESOURCE_NAME": "envres"
    }
   },
   "expected": {
    "ok": "https://envres.openai.azure.com/openai/v1"
   }
  },
  {
   "name": "modelFallback",
   "model": {
    "id": "gpt-4o",
    "baseUrl": "https://model.example.com/"
   },
   "options": null,
   "expected": {
    "ok": "https://model.example.com"
   }
  },
  {
   "name": "whitespaceOption",
   "model": {
    "id": "gpt-4o",
    "baseUrl": "https://model.example.com"
   },
   "options": {
    "azureBaseUrl": "   "
   },
   "expected": {
    "ok": "https://model.example.com"
   }
  },
  {
   "name": "resourceTrumpsModel",
   "model": {
    "id": "gpt-4o",
    "baseUrl": "https://model.example.com"
   },
   "options": {
    "azureResourceName": "res"
   },
   "expected": {
    "ok": "https://res.openai.azure.com/openai/v1"
   }
  },
  {
   "name": "emptyEnvIgnored",
   "model": {
    "id": "gpt-4o",
    "baseUrl": ""
   },
   "options": {
    "env": {
     "AZURE_OPENAI_BASE_URL": "",
     "AZURE_OPENAI_RESOURCE_NAME": ""
    }
   },
   "expected": {
    "error": "Azure OpenAI base URL is required. Set AZURE_OPENAI_BASE_URL or AZURE_OPENAI_RESOURCE_NAME, or pass azureBaseUrl, azureResourceName, or model.baseUrl."
   }
  }
 ],
 "configCases": [
  {
   "model": {
    "id": "gpt-4o",
    "baseUrl": "https://model.example.com"
   },
   "options": null,
   "expected": {
    "ok": {
     "baseUrl": "https://model.example.com",
     "apiVersion": "v1"
    }
   }
  },
  {
