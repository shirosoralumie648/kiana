    "azureApiVersion": ""
   },
   "expected": {
    "ok": {
     "baseUrl": "https://res.openai.azure.com/openai/v1",
     "apiVersion": "v1"
    }
   }
  }
 ],
 "deploymentCases": [
  {
   "id": "gpt-4o",
   "options": {
    "azureDeploymentName": "explicit"
   },
   "expected": {
    "ok": "explicit"
   }
  },
  {
   "id": "gpt-4o",
   "options": {
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "gpt-4o=fast,gpt-4o-mini=mini"
    }
   },
   "expected": {
    "ok": "fast"
   }
  },
  {
   "id": "gpt-4o-mini",
   "options": {
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "gpt-4o=fast,gpt-4o-mini=mini"
    }
   },
   "expected": {
    "ok": "mini"
   }
  },
  {
   "id": "other",
   "options": {
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "gpt-4o=fast"
    }
   },
   "expected": {
    "ok": "other"
   }
  },
  {
   "id": "gpt-4o",
   "options": {
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "gpt-4o="
    }
   },
   "expected": {
    "ok": "gpt-4o"
   }
  },
  {
   "id": "a=b",
   "options": {
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "a=b=weird"
    }
   },
   "expected": {
    "ok": "a=b"
   }
  },
  {
   "id": "x",
   "options": {
    "azureDeploymentName": "",
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "x=mapped"
    }
   },
   "expected": {
    "ok": "mapped"
   }
  },
  {
   "id": "spaces",
   "options": {
    "env": {
     "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": " spaces = deployed ,  =x, y = "
    }
   },
   "expected": {
    "ok": "deployed"
   }
  }
 ]
}
